# Copy this file to .env.local and fill in real values (never commit
# .env.local — it's already gitignored). scripts/seed-demo-data.ts,
# reset-demo.ts, and simulate-conflict.ts all auto-load .env.local via
# dotenv; nothing else in the repo reads this file automatically —
# `cdk deploy`/`cdk bootstrap` use the AWS CLI/CDK's own standard
# credential resolution (see "Deploying" below), and apps/web has its
# own .env.example (Vite loads that one directly).
#
# ============================================================
# AWS services this project actually needs an account to have
# ============================================================
# All of these are provisioned automatically by `cdk deploy` from
# infra/cdk — you don't create any of them by hand in the console,
# except the one explicit step called out below.
#
#   - Lambda            11 functions (write-intake, conflict-resolver,
#                        sync/audit query, ws connect/disconnect,
#                        conflict-resolve, products/categories/
#                        suppliers CRUD, checkout)
#   - DynamoDB           8 tables, on-demand billing (inventory_records,
#                        write_dedup, audit_log, ws_connections,
#                        products, categories, suppliers, orders)
#   - SQS                1 FIFO write queue + 1 FIFO dead-letter queue
#   - API Gateway         1 HTTP API (REST) + 1 WebSocket API
#   - CloudWatch          custom metrics + a dashboard (Observability construct)
#   - Bedrock             InvokeModel on anthropic.claude-haiku-4-5-20251001-v1:0
#                        only — ***you must manually enable model access***
#                        for this one model: AWS Console -> Amazon Bedrock
#                        -> Model access -> request/enable Claude Haiku 4.5.
#                        Do this before `cdk deploy`, not after — approval
#                        can take a while depending on account history.
#                        Nothing else in this stack needs a console step.
#   - IAM                 roles/policies for the above, all scoped
#                        least-privilege by the CDK constructs themselves
#
# Not needed for the Tier-1 core engine or the Tier-2 CRUD/checkout
# layer (Cognito, SNS/SES, Transcribe, EventBridge, Rekognition) are
# roadmap items — see README's "Where this goes next".
#
# Frontend hosting (AWS Amplify Hosting) is a separate deploy, not part
# of `cdk deploy` — see "Deploying" below.

# ============================================================
# AWS credentials — used by `cdk bootstrap`/`cdk deploy` (via the AWS
# CLI/CDK's standard credential chain) and by the AWS SDK v3 clients in
# scripts/seed-demo-data.ts, reset-demo.ts (whenever DYNAMODB_ENDPOINT
# below is NOT set, they talk to real AWS using these).
# ============================================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed for temporary/STS credentials (e.g. an IAM Identity
# Center / SSO session) — leave blank for a long-lived IAM user's keys.
AWS_SESSION_TOKEN=
AWS_REGION=us-east-1
# CDK reads these two for `cdk bootstrap`/`cdk deploy` when the stack
# isn't pinned to an explicit env in code (this one isn't) — usually
# redundant with AWS_ACCESS_KEY_ID/AWS_REGION above, but CDK looks for
# these specific names too, so set them the same.
CDK_DEFAULT_ACCOUNT=
CDK_DEFAULT_REGION=us-east-1

# ============================================================
# Deploying
# ============================================================
# `cdk bootstrap`/`cdk deploy` (run from infra/cdk) do NOT read this
# .env.local file automatically — they use the AWS CLI/CDK's own
# credential resolution, which checks (in order) environment variables,
# then ~/.aws/credentials. The simplest path: run `aws configure` once
# with the same Access Key ID / Secret Access Key / region you put
# above, OR export these same variables into your shell before running
# `cdk deploy` (PowerShell: `$env:AWS_ACCESS_KEY_ID = "..."`, etc.).
#
# After `cdk deploy` succeeds, copy every one of its printed CfnOutput
# values into the corresponding variable below — seed-demo-data.ts and
# reset-demo.ts need the table names; apps/web's own .env.example needs
# the two API URLs (see that file, not this one).

# ============================================================
# Resource names — from `cdk deploy`'s CfnOutputs, or
# `aws dynamodb list-tables` / `aws cloudformation describe-stacks`
# after deploy. Required by seed-demo-data.ts and reset-demo.ts.
# ============================================================
INVENTORY_RECORDS_TABLE_NAME=
AUDIT_LOG_TABLE_NAME=
WRITE_DEDUP_TABLE_NAME=
WS_CONNECTIONS_TABLE_NAME=
# Tier 2 (19b) — optional: seed-demo-data.ts skips catalog seeding
# gracefully if these three aren't all set.
PRODUCTS_TABLE_NAME=
CATEGORIES_TABLE_NAME=
SUPPLIERS_TABLE_NAME=

# Only needed for scripts/simulate-conflict.ts, against a real deployed
# API (defaults to the local dev server's http://localhost:4000 if unset).
API_BASE_URL=
# Decorative today, not actually enforced server-side (see
# 07-EDGE-CASES.md edge case E-1, a stated known limitation) — set to
# anything non-empty; it's sent as the x-api-key header but no Lambda
# or API Gateway usage plan currently validates it.
API_KEY=local-e2e-key
SHOP_ID=demo-shop
